  "authors": [
    "arsham"
  ],
  "contact": {
    "sources": "https://github.com/arshamkhakpour1391-afk/PingFix"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.arshamkhakpour1391.pingfix.client.PingFixClient"
    ]
  },
  "mixins": [
    "pingfix.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "icon": "assets/pingfix/icon.png"
}
